#!/bin/bash
set -euo pipefail

if [[ $# -lt 2 ]]
then
  echo "Usage: $0 <host> <port> [timeout]" >&2
  exit 1
fi

DEFAULT_TIMEOUT=60

SERVER="$1"
PORT="$2"
TIMEOUT="${3:-$DEFAULT_TIMEOUT}"

while true
do
  exec {FD}<>/dev/tcp/"$SERVER"/"$PORT" || { echo "Warning: Failed to connect; retrying ..." >&2; sleep 3; continue; }
  trap 'exec {FD}>&-' EXIT

  echo "Connected to $SERVER on port $PORT." >&2

  while read -rt "$TIMEOUT" LINE <&$FD
  do
    if [[ "$LINE" == PING ]]
    then
      echo "PONG" >&$FD
    elif [[ "$LINE" == RELAY\ * ]] && DATA=$(echo "${LINE#RELAY }" | base64 -d 2>/dev/null)
    then
      echo "$DATA"
    else
      echo "Warning: An error occurred while processing command: '$LINE'" >&2
    fi
  done

  exec {FD}>&-
  trap - EXIT

  echo "Warning: Connection was reset or timed out; reconnecting ..." >&2
  sleep 3
done
