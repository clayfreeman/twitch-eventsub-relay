#!/bin/bash
set -euo pipefail

if [[ $# -lt 2 ]]
then
  echo "Usage: $0 <host> <port> [timeout]" >&2
  exit 1
fi

DEFAULT_TIMEOUT=60

SERVER="$1"
PORT="$2"
TIMEOUT="${3:-$DEFAULT_TIMEOUT}"

exec 3<>/dev/tcp/"$SERVER"/"$PORT"
trap 'exec 3>&-' EXIT

while read -rt "$TIMEOUT" LINE <&3
do
  if [[ "$LINE" == "PING" ]]
  then
    echo "PONG" >&3
  elif DATA=$(echo "${LINE#RELAY }" | base64 -d 2>/dev/null)
  then
    echo "$DATA"
  else
    break
  fi
done

echo "Error: Connection was reset or timed out" >&2
exit 1
